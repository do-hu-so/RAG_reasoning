# Sao chép file này thành .env (cùng thư mục) rồi điền API key.
# Trên Vercel: khai báo các biến này trong Settings -> Environment Variables.
# Cần ít nhất MỘT nhà cung cấp LLM (Gemini hoặc Groq). Có nhiều nhà cung cấp thì
# hết quota ở bên đầu sẽ tự chuyển sang bên sau.

# --- LLM: Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Mức suy luận của model khi trả lời: minimal | low | medium | high | off
# GEMINI_THINKING_LEVEL=medium

# --- LLM: Groq, free tier rộng (https://console.groq.com/keys) ---
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- LLM: API tương thích OpenAI bất kỳ, ví dụ OpenRouter ---
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=<model id, ví dụ một model có hậu tố :free>

# Thứ tự thử các nhà cung cấp (mặc định gemini,groq,openai). Muốn dùng Groq trước: groq,gemini
# LLM_PROVIDERS=gemini,groq,openai

# --- Embedding của bản web ---
# auto (mặc định): Cloudflare nếu có key -> Gemini nếu có key -> chỉ tìm kiếm từ khoá
# WEB_EMBEDDING_PROVIDER=auto
# Cloudflare Workers AI, model bge-m3 đa ngôn ngữ, free tier rộng (https://dash.cloudflare.com)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# --- Bản web ---
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMENSIONS=768
# Chế độ của Vercel Blob store: private (mặc định) hoặc public
# BLOB_ACCESS=private
# Chạy web trên máy mà muốn lưu vào Vercel Blob thay vì thư mục dataset_web/:
# BLOB_READ_WRITE_TOKEN=
# MAX_UPLOAD_MB=4
# WEB_CHUNK_SIZE=800
# WEB_CHUNK_OVERLAP=150
# WEB_TOP_N=6

# --- Bản dòng lệnh (chat.py / run.py) ---
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=100
# RAG_INITIAL_K=10
# RAG_TOP_N=5
