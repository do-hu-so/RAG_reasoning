# Sao chép file này thành .env (cùng thư mục) rồi điền API key.
# Trên Vercel: khai báo các biến này trong Settings -> Environment Variables.
# Lấy API key Gemini tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ----- Tuỳ chọn (bỏ dấu # để ghi đè giá trị mặc định) -----
# GEMINI_MODEL=gemini-3.5-flash
# Mức suy luận của model khi trả lời: minimal | low | medium | high | off
# GEMINI_THINKING_LEVEL=medium

# --- Bản web ---
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMENSIONS=768
# Chế độ của Vercel Blob store: private (mặc định) hoặc public
# BLOB_ACCESS=private
# Chạy web trên máy mà muốn lưu vào Vercel Blob thay vì thư mục dataset_web/:
# BLOB_READ_WRITE_TOKEN=
# MAX_UPLOAD_MB=4
# WEB_CHUNK_SIZE=800
# WEB_CHUNK_OVERLAP=150
# WEB_TOP_N=6

# --- Bản dòng lệnh (chat.py / run.py) ---
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=100
# RAG_INITIAL_K=10
# RAG_TOP_N=5
