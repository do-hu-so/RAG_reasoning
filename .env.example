# Sao chép file này thành .env (cùng thư mục) rồi điền API key.
# Trên Vercel: KHÔNG dùng file này — khai báo từng biến trong
#   Project -> Settings -> Environment Variables, rồi Redeploy.

# --- LLM: Groq (bắt buộc) — lấy key tại https://console.groq.com/keys ---
GROQ_API_KEY=

# Các model Groq theo thứ tự ưu tiên. Groq tính hạn mức riêng cho từng model:
# model đầu hết quota thì app tự chuyển sang model kế tiếp.
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant
# Mức suy luận của các model gpt-oss: low | medium | high | off
# GROQ_REASONING_EFFORT=medium

# --- Embedding của bản web (tuỳ chọn) ---
# Cloudflare Workers AI, model bge-m3 đa ngôn ngữ, free tier rộng (https://dash.cloudflare.com)
# Không đặt 2 biến này thì app chỉ dùng tìm kiếm từ khoá (BM25) — vẫn chạy bình thường.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# auto (mặc định): Cloudflare nếu có key, không thì chỉ tìm từ khoá | cloudflare | none
# WEB_EMBEDDING_PROVIDER=auto

# --- Bản web ---
# Chế độ của Vercel Blob store: private (mặc định) hoặc public
# BLOB_ACCESS=private
# Chạy web trên máy mà muốn lưu vào Vercel Blob thay vì thư mục dataset_web/:
# BLOB_READ_WRITE_TOKEN=
# MAX_UPLOAD_MB=4
# WEB_CHUNK_SIZE=800
# WEB_CHUNK_OVERLAP=150
# WEB_TOP_N=6
# Phương pháp 03: số đoạn ứng viên trước khi xếp hạng lại
# WEB_RERANK_CANDIDATES=15
# Đặt 1 để phương pháp 04 (RAG + Reasoning) xếp hạng lại trước khi suy luận
# WEB_REASONING_RERANK=

# --- Bản dòng lệnh (chat.py / run.py) ---
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=100
# RAG_INITIAL_K=10
# RAG_TOP_N=5
